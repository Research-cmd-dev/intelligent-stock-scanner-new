# Copy to .env and fill in. Polygon is optional — without it the scanner falls
# back to yfinance automatically.

POLYGON_API_KEY=

# Optional: override cache + log locations
# CACHE_DIR=data/cache
# LOG_LEVEL=INFO

# Optional: override the historical OHLCV store root.
# Modal jobs set this to /data/historical (the mounted volume) automatically;
# locally this defaults to data/historical/.
# STOCK_DATA_ROOT=data/historical

# Modal authentication is configured via `modal token new` (writes ~/.modal.toml).
# Secrets like POLYGON_API_KEY above are shipped to Modal containers via
# `modal.Secret.from_dotenv` — no separate Modal secret is required for
# the solo-dev flow.
